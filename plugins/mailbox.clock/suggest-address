#!/usr/bin/env python3
"""Answer a half-typed place with OSM addresses, for the panel's location row.

One argument: the query. The reply is written to
~/.cache/omarchy/mailbox.clock/location-suggest.json as

    {"query": "<what was asked>", "country": "DE",
     "features": [ ... Photon features ... ]}

so Panel.qml can drop an answer that arrived after the word moved on.
Photon (photon.komoot.io) rather than Nominatim on purpose: Nominatim's
usage policy forbids typeahead queries, Photon is built for them.

The query is never passed through a shell — Panel.qml hands it as a Process
argv element and it is URL-encoded here. Failure is silent by design: no
network, no suggestions, and the field stays plain free text.
"""

from __future__ import annotations

import json
import os
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ENDPOINT = "https://photon.komoot.io/api"
AGENT = "omarchy-mailbox.clock/1.0 (calendar widget location field)"
# More than the list shows on purpose: Photon has no country filter and
# ranks by its own relevance, so "Garbe" can come back led by Ohio. The
# panel floats the home country up and cuts the list down afterwards.
LIMIT = 15
TIMEOUT = 4.0
HOME_COUNTRY = os.environ.get("MAILBOX_CLOCK_SUGGEST_COUNTRY") or os.environ.get("PA_CLOCK_SUGGEST_COUNTRY", "DE")

CACHE = Path(os.environ.get("MAILBOX_CLOCK_CACHE_DIR")
             or os.environ.get("PA_CLOCK_CACHE_DIR")
             or (Path.home() / ".cache" / "omarchy" / "mailbox.clock"))
OUT = CACHE / "location-suggest.json"


def fetch(query: str) -> list:
    params = {"q": query, "limit": str(LIMIT), "lang": os.environ.get("MAILBOX_CLOCK_SUGGEST_LANG") or os.environ.get("PA_CLOCK_SUGGEST_LANG", "de")}
    # Bias towards where the user is, when a home has been set, so a local
    # "Garbe" outranks one three states away.
    lat = os.environ.get("MAILBOX_CLOCK_SUGGEST_LAT") or os.environ.get("PA_CLOCK_SUGGEST_LAT", "")
    lon = os.environ.get("MAILBOX_CLOCK_SUGGEST_LON") or os.environ.get("PA_CLOCK_SUGGEST_LON", "")
    if lat and lon:
        params["lat"] = lat
        params["lon"] = lon
    url = ENDPOINT + "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(url, headers={"User-Agent": AGENT})
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        doc = json.loads(response.read().decode("utf-8"))
    features = doc.get("features")
    return features if isinstance(features, list) else []


def write(payload: dict) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    handle, tmp = tempfile.mkstemp(dir=str(CACHE), prefix="location-suggest.")
    with os.fdopen(handle, "w", encoding="utf-8") as out:
        json.dump(payload, out, ensure_ascii=False)
    os.replace(tmp, OUT)


def main(argv: list) -> int:
    query = (argv[1] if len(argv) > 1 else "").strip()
    if not query:
        write({"query": "", "country": HOME_COUNTRY, "features": []})
        return 0
    try:
        features = fetch(query)
    except (urllib.error.URLError, TimeoutError, ValueError, OSError):
        # Offline or a bad reply: an empty answer, so the list just closes.
        features = []
    write({"query": query, "country": HOME_COUNTRY, "features": features})
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
